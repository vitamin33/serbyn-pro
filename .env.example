NEXT_PUBLIC_SITE_NAME="Serbyn Pro"

# Analytics (optional — site works without these)
# PostHog: engagement events (which blocks work) + conversion funnels.
# Without a key, all custom events no-op cleanly.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# The browser reaches PostHog through /ingest on this site (next.config.js),
# and only on serbyn.io. To send events from localhost while testing:
# NEXT_PUBLIC_POSTHOG_ANY_HOST=1
